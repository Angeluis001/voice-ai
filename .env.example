XAI_API_KEY=replace-me-locally
XAI_BASE_URL=https://api.x.ai/v1
VOICE_MVP_LANGUAGE=en
VOICE_MVP_STT_KEYTERM=
VOICE_MVP_GROK_MODEL=grok-4.3
VOICE_MVP_TTS_VOICE=eve
VOICE_MVP_RECORD_SECONDS=5
VOICE_MVP_SAMPLE_RATE=16000

# --- Rust voice agent (all optional) ---
# Realtime voice endpoint and model.
XAI_REALTIME_URL=wss://api.x.ai/v1/realtime?model=grok-voice-think-fast-1.0
# Mic mode (`voice-agent talk`): session audio rate, and device names (part of the name is enough).
VOICE_AI_LOCAL_SAMPLE_RATE=24000
VOICE_AI_INPUT_DEVICE=
VOICE_AI_OUTPUT_DEVICE=
# Turn detection and live transcription.
VOICE_AI_VAD_THRESHOLD=0.55
VOICE_AI_VAD_SILENCE_MS=480
VOICE_AI_VAD_PREFIX_MS=200
VOICE_AI_TRANSCRIBE_MODEL=grok-transcribe
VOICE_AI_LANGUAGE_HINT=en
# Client pack used when a call does not name one.
VOICE_AI_DEFAULT_CLIENT_ID=sbr
# Linphone provisioning for extension 1001 is off unless this is set.
VOICE_LINPHONE_1001_PASSWORD=
